{
  "permissions": {
    "allow": [
      "mcp__pencil"
    ]
  },
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/scripts/hooks/stop-bell.sh"
          },
          {
            "type": "command",
            "command": "~/.claude/scripts/hooks/typecheck-on-stop.sh"
          },
          {
            "type": "command",
            "command": "~/.claude/scripts/hooks/history-on-stop.sh"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/scripts/hooks/bash-log.sh"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/scripts/hooks/lint-on-edit.sh"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/scripts/hooks/session-start.sh"
          },
          {
            "type": "command",
            "command": "~/.claude/scripts/hooks/history-on-session-start.sh"
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/scripts/hooks/pre-compact.sh"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/scripts/hooks/history-on-user-prompt.sh"
          },
          {
            "type": "command",
            "command": "~/.claude/scripts/hooks/lessons-auto-capture.sh"
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "input=$(cat); dir=$(echo \"$input\" | jq -r '.workspace.current_dir'); git_info=$(cd \"$dir\" 2>/dev/null && git -c core.useBuiltinFSMonitor=false -c index.skipHash=false symbolic-ref --short HEAD 2>/dev/null || git -c core.useBuiltinFSMonitor=false -c index.skipHash=false rev-parse --short HEAD 2>/dev/null); dirty=$(cd \"$dir\" 2>/dev/null && [ -n \"$(git -c core.useBuiltinFSMonitor=false -c index.skipHash=false status --porcelain 2>/dev/null)\" ] && echo '*' || echo ''); username=$(whoami); hostname=$(hostname -s); printf \"\\033[38;5;32m%s\" \"$dir\"; [ -n \"$git_info\" ] && printf \" \\033[38;5;75m(\\033[38;5;78m%s\\033[38;5;214m%s\\033[38;5;75m)\" \"$git_info\" \"$dirty\"; printf \" \\033[38;5;105m»\\033[0m \\033[38;5;237m%s@%s\\033[0m\" \"$username\" \"$hostname\""
  },
  "enabledPlugins": {
    "learning-opportunities@learning-opportunities": true,
    "frontend-design@claude-plugins-official": true,
    "context7@claude-plugins-official": true,
    "code-simplifier@claude-plugins-official": true,
    "playwright@claude-plugins-official": true,
    "code-review@claude-plugins-official": true,
    "superpowers@claude-plugins-official": true,
    "security-guidance@claude-plugins-official": true,
    "github@claude-plugins-official": true,
    "feature-dev@claude-plugins-official": false,
    "claude-md-management@claude-plugins-official": true,
    "serena@claude-plugins-official": true,
    "playground@claude-plugins-official": true,
    "vercel@claude-plugins-official": true,
    "swift-lsp@claude-plugins-official": true
  },
  "extraKnownMarketplaces": {
    "learning-opportunities": {
      "source": {
        "source": "git",
        "url": "https://github.com/DrCatHicks/learning-opportunities.git"
      }
    }
  },
  "skipDangerousModePermissionPrompt": true,
  "autoCompactEnabled": false
}
